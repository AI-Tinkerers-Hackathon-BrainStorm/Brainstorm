# Required. Keep this server-side; never prefix it with NEXT_PUBLIC_.
DASHSCOPE_API_KEY=

# Optional. The default is the China (Beijing) compatible endpoint.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional model overrides.
QWEN_REALTIME_MODEL=qwen3.5-omni-flash-realtime
QWEN_TEXT_MODEL=qwen3.8-flash
QWEN_VISION_MODEL=qwen3.8-flash
QWEN_DEEP_VISION_MODEL=qwen3.8-max
QWEN_OCR_MODEL=qwen3.5-ocr

# Vercel builds the bundled multilingual whisper.cpp base-q5_1 runtime. No
# Whisper API key is used, and model weights are never sent to the browser.

# Optional. Voice used by the realtime model. Client-visible by design, so it
# must keep the NEXT_PUBLIC_ prefix. Harvey is a low, mellow male voice; switch
# to Ethan if the configured model rejects it.
NEXT_PUBLIC_QWEN_REALTIME_VOICE=Harvey

# Supabase Data API values. Both are safe for browser use only when RLS remains enabled.
# Enable Anonymous Sign-Ins in Supabase Auth for the demo's isolated memory identity.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
