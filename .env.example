# Required. Keep this server-side; never prefix it with NEXT_PUBLIC_.
DASHSCOPE_API_KEY=

# Required for WebRTC. Replace YOUR_WORKSPACE_ID with the workspace that owns the Beijing API key.
# Without this, text and vision can use the legacy default, but realtime starts in FALLBACK.
DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# Optional model overrides.
QWEN_REALTIME_MODEL=qwen3.5-omni-flash-realtime
QWEN_TEXT_MODEL=qwen3.8-flash
QWEN_VISION_MODEL=qwen3.8-flash
QWEN_DEEP_VISION_MODEL=qwen3.8-max
QWEN_OCR_MODEL=qwen3.5-ocr
